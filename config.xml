<?xml version='1.0' encoding='utf-8'?>
<widget id="com.fatrunner.trapworld" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Fat Runner: Trap World</name>
    <description>500-level trap platformer with 25 unique themes.</description>
    <author email="dev@fatrunner.com" href="https://fatrunner.com">Dev Team</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <preference name="Orientation" value="landscape" />
        <preference name="Fullscreen" value="true" />
        <preference name="StatusBarOverlaysWebView" value="false" />
        <preference name="StatusBarBackgroundColor" value="#1a1a2e" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="AndroidXEnabled" value="true" />
        <preference name="GradlePluginGoogleServicesEnabled" value="false" />
    </platform>
    <icon src="www/assets/icon.png" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="#0x1a1a2e" />

    <plugin name="cordova-plugin-admob-free" spec="^0.27.0">
        <variable name="ADMOB_APP_ID" value="ca-app-pub-3940256099942544~3347511713" />
    </plugin>
</widget>
